# Styled to match the Quickshell notch (../quickshell/config/Theme.qml):
# pure black, soft warm-grey type, Inter, and the notch's own corner radius.
# Notifications drop from underneath the notch on the centre line, at exactly
# the notch's collapsed width, so they read as it handing you a message.

[global]
    monitor = 0
    follow = mouse

    ### geometry — matches Theme.notchWidth / notchHeight ###
    width = 400
    height = (0, 320)
    origin = top-center
    offset = (0, 42)
    scale = 0
    notification_limit = 4
    gap_size = 8
    corner_radius = 18
    padding = 15
    horizontal_padding = 18
    frame_width = 1
    frame_color = "#211f1d"
    separator_height = 1
    separator_color = "#1c1a18"
    transparency = 0

    ### type — Theme.fontUI, Theme.text / Theme.subtext ###
    font = Inter 10
    line_height = 4
    markup = full
    format = "<span foreground='#ece6dd' weight='bold'>%s</span>\n<span foreground='#9b9186'>%b</span>"
    alignment = left
    vertical_alignment = center
    ellipsize = middle
    ignore_newline = no
    show_age_threshold = 60
    word_wrap = yes

    ### icons — same rounding as the notch's album art ###
    icon_position = left
    icon_corner_radius = 11
    min_icon_size = 32
    max_icon_size = 40
    text_icon_padding = 14
    icon_path = /usr/share/icons/Paper/16x16/status/:/usr/share/icons/Paper/16x16/devices/:/usr/share/icons/Paper/16x16/apps/

    ### progress bar — Theme.accent2, the notch's volume/OSD colour ###
    progress_bar = true
    progress_bar_height = 6
    progress_bar_corner_radius = 3
    progress_bar_frame_width = 0
    progress_bar_min_width = 160
    progress_bar_max_width = 364
    highlight = "#caf0f8"

    ### behaviour ###
    indicate_hidden = yes
    sort = yes
    idle_threshold = 120
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = no
    sticky_history = yes
    history_length = 20
    always_run_script = true
    ignore_dbusclose = false
    force_xinerama = false
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#000000"
    foreground = "#9b9186"
    frame_color = "#1a1917"
    highlight = "#caf0f8"
    timeout = 8
    default_icon = dialog-information

[urgency_normal]
    background = "#000000"
    foreground = "#ece6dd"
    frame_color = "#211f1d"
    highlight = "#caf0f8"
    timeout = 10
    override_pause_level = 30
    default_icon = dialog-information

# Critical keeps the notch's black rather than flooding red — the frame and
# the accent do the shouting, the way Theme.crit is used in the bar.
[urgency_critical]
    background = "#000000"
    foreground = "#ece6dd"
    frame_color = "#e05c5c"
    highlight = "#e05c5c"
    timeout = 0
    override_pause_level = 60
    default_icon = dialog-warning
